# =============================================================================
# Candidate Service Environment Configuration Template
# Copy this to .env
# =============================================================================

MODE=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database (maps to apply_candidate_db on host port 5434)
DB_NAME=candidate_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5434

# MongoDB (NoSQL / Activity Logs)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=apply_logs

# JWT Authentication
JWT_ACCESS=candidate_access_token
JWT_REFRESH=candidate_refresh_token
COOKIE_DOMAIN=

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=candidate-service-group

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=candidate-bucket

# Static & Media Prefixes
BASE_PREFIX=
STATIC_URL=static/
MEDIA_URL=media/

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001
