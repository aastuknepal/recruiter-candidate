# =============================================================================
# Recruiter Service Environment Configuration Template
# Copy this to .env
# =============================================================================

MODE=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database (maps to apply_recruiter_db on host port 5433)
DB_NAME=recruiter_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5433

# JWT Authentication
JWT_ACCESS=recruiter_access_token
JWT_REFRESH=recruiter_refresh_token
COOKIE_DOMAIN=

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=recruiter-service-group

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=recruiter-bucket

# Redis / Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Static & Media Prefixes
BASE_PREFIX=
STATIC_URL=static/
MEDIA_URL=media/

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001
